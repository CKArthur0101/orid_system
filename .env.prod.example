# Copy this file to `.env.prod` on the production host and fill in real secrets.

# Docker compose host bindings and host-side backup location
PROD_FRONTEND_PORT=3201
# 本機若已有其他 stack 用 18080，請改成未佔用的埠（與 docker-compose.prod.yml 預設 18082 一致即可）
PROD_BACKEND_PORT=18082
PROD_DB_PORT=15434
BACKUP_DIR=runtime\backups\postgres

# Postgres container settings used by `docker-compose.prod.yml`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=orid_prod

# 後端／Alembic 在容器內依 POSTGRES_* 組 DATABASE_URL（見 start.prod.sh、alembic_migrations/env.py）。
DB_DISABLE_POOLING=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SEC=30
DB_POOL_RECYCLE_SEC=1800

ACCESS_SECRET_KEY=replace_me
RESET_PASSWORD_SECRET_KEY=replace_me
VERIFICATION_SECRET_KEY=replace_me
ACCESS_TOKEN_EXPIRE_SECONDS=43200

# 公開註冊與忘記／重設密碼 API。測試期可設 true 自行註冊帳號；上線收斂請改 false。
ENABLE_PUBLIC_REGISTRATION_AND_PASSWORD_RESET=true
# 前端 build 時讀取；與上一項同步為 true 時登入頁會顯示「前往註冊」。
NEXT_PUBLIC_ENABLE_PUBLIC_REGISTRATION_AND_PASSWORD_RESET=true

FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=["https://your-frontend.example.com"]
OPENAI_API_KEY=replace_me
# 寫作回饋品質優先建議 gpt-4o；若帳號僅支援 GPT-5 可改 gpt-5-mini。
OPENAI_MODEL=gpt-4o
# 單次 completion 輸出上限；寫作 assist／教練長回覆用此值。「取得回饋」三段敘述預設為 min(640, 此值)，可另設 ORID_FEEDBACK_NARRATION_MAX_COMPLETION_TOKENS。
OPENAI_MAX_COMPLETION_TOKENS=1500
OPENAI_TEMPERATURE=0.7
ORID_MAIN_FALLBACK_TEMPERATURE=0.75
ORID_FOLLOWUP_TEMPERATURE=0.65
# 選填：結構化「取得回饋」JSON 專用；未設定時後端為 max(OPENAI_MAX_COMPLETION_TOKENS, 1800)。
# ORID_FEEDBACK_MAX_COMPLETION_TOKENS=2000
# 選填：JSON→三段敘述第二段 LLM；預設 640（仍不超過 OPENAI_MAX_COMPLETION_TOKENS）。
# ORID_FEEDBACK_NARRATION_MAX_COMPLETION_TOKENS=640
OPENAPI_OUTPUT_FILE=./shared-data/openapi.json
ORID_RAG_BACKEND=auto
ORID_EMBEDDINGS_DIR=/app/shared-data/embeddings
ORID_FORCE_NEW_ALLOWLIST=

# Optional mail settings: uncomment and fill these only if you use SMTP in prod.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=ORID
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_STARTTLS=True
# MAIL_SSL_TLS=False
# USE_CREDENTIALS=True
# VALIDATE_CERTS=True

# Optional FastAPI hardening: uncomment to disable `/docs` and `/openapi.json`
# OPENAPI_URL=

# Frontend runtime settings
API_BASE_URL=http://backend:8000
ACCESS_TOKEN_COOKIE_MAX_AGE_SEC=43200

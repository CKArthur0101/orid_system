# Backend API base URL
API_BASE_URL=http://localhost:8000
ACCESS_TOKEN_COOKIE_MAX_AGE_SEC=43200

# 設為 false 時登入頁不顯示「前往註冊」；未設定或非 false 時顯示（後端仍須 ENABLE_PUBLIC_REGISTRATION_AND_PASSWORD_RESET=true 註冊才會成功）
NEXT_PUBLIC_ENABLE_PUBLIC_REGISTRATION_AND_PASSWORD_RESET=true

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json
# Local database（若用專案 docker-compose，主庫對外 port 為 15432）
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:15432/mydatabase

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/testdatabase

# Secret keys
ACCESS_SECRET_KEY=your_access_secret_key
RESET_PASSWORD_SECRET_KEY=your_reset_password_secret_key
VERIFICATION_SECRET_KEY=your_verification_secret_key

# OpenAPI genrated file output path
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# Localhost Email configuration
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Frontend (NextJS)
FRONTEND_URL=http://localhost:3000

# CORS (Allow all origins for development; adjust this to restrict origins in production deployments)
CORS_ORIGINS=["*"]

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""

# ORID: 新版週頁面使用 POST /orid/writing-coach/chat（寫作教練）；舊版 POST /orid/chat 已移除。
# ORID RAG backend: auto|faiss|memory（教練對話可選引用讀本摘要）
ORID_RAG_BACKEND=auto
# Optional embeddings root inside backend container/runtime
ORID_EMBEDDINGS_DIR=/app/shared-data/embeddings

# ORID stage progression (預設略鬆於早期版本：每階需累積的「通過」次數與最少 AI 回合)
# ORID_REQUIRED_PASS=2
# ORID_MIN_AI_TURNS=1
# 各階可覆寫：ORID_REQUIRED_PASS_O、ORID_MIN_AI_TURNS_O 等
# ORID stage progression mode: guided|strict
ORID_PROGRESSION_MODE=guided
# 同一階連續未通過達此輪數後，guided 會放寬 required_pass（仍須出現通過回合才會 +1）
ORID_GUIDED_STUCK_THRESHOLD=3
ORID_GUIDED_PASS_RELAX=1
ORID_GUIDED_MIN_PASS=1
ORID_GUIDED_RELAX_MIN_TURNS=0